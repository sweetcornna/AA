# Generate a complete root-only file with scripts/generate-env.py.
# Never copy placeholder values into a running stack.
AA_ENVIRONMENT=staging
AA_STACK_ID=aa-staging-primary
AA_SOURCE_FINGERPRINT=<64-character-source-fingerprint>
AA_RUNTIME_ROOT=/srv/aa/staging/runtime
AA_UPSTREAM_DIR=/srv/aa/staging/runtime/upstream/0e5c073b464b76a1046ff3e9a8467ebbb41a376d
AA_FUNCTIONS_DIR=/srv/aa/staging/runtime/functions/<source-fingerprint>
AA_TEMPLATE_DIR=/srv/aa/staging/runtime/templates/<source-fingerprint>
AA_KONG_BIND_HOST=127.0.0.1
AA_KONG_HTTP_PORT=18100
SUPABASE_PUBLIC_URL=https://staging-api.cornna.xyz
API_EXTERNAL_URL=https://staging-api.cornna.xyz/auth/v1
SITE_URL=https://staging-api.cornna.xyz
POSTGRES_PASSWORD=<generated>
JWT_SECRET=<generated>
ANON_KEY=<generated-public-anon-jwt>
SERVICE_ROLE_KEY=<generated-secret-service-role-jwt>
SECRET_KEY_BASE=<generated>
REALTIME_DB_ENC_KEY=<generated-16-characters>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=<runtime-secret>
SMTP_ADMIN_EMAIL=<verified-sender>
SMTP_SENDER_NAME=AA
OPENAI_API_KEY=<runtime-secret>
BACKUP_DIR=/srv/aa/backups/staging
BACKUP_AGE_RECIPIENT=<age-public-recipient>
AZURE_STORAGE_ACCOUNT=<azure-storage-account>
AZURE_STORAGE_CONTAINER=<environment-specific-container>
