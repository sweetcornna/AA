# Copy to apps/app/.env for local development and fill from `supabase status`.
# Production builds use exact https://aa-api.cornna.xyz plus its public anon/
# publishable key from a protected GitHub environment. Never put service-role,
# SMTP, OpenAI, database, JWT, or signing secrets in VITE_*.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-local-public-key

# Optional. Public URL of the hosted web build; makes invitation links ordinary
# https links instead of the aa:// scheme. The Pages workflow fills this in from
# the repository's Pages settings, so leave it unset for local development.
# VITE_WEB_ORIGIN=https://sweetcornna.github.io/AA/
